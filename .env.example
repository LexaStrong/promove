# ─────────────────────────────────────────────────────────────
# ProMove Fleet Environment Configuration (Example Template)
# Copy this to .env.local for local development,
# and configure these keys in Vercel Project Settings > Environment Variables
# ─────────────────────────────────────────────────────────────

# Canonical public origin
NEXT_PUBLIC_SITE_URL=https://promove.gh

# Clerk Authentication (Required for login, signup & middleware proxy)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/onboarding

# Neon Lakebase Postgres Database
DATABASE_URL=postgresql://neondb_owner:YOUR_DATABASE_PASSWORD@ep-still-mountain-b43zkaju-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Project & Storage (S3-compatible)
NEON_PROJECT_ID=your_neon_project_id
NEON_BRANCH_ID=your_neon_branch_id
NEON_API_TOKEN=nt_live_your_neon_api_token
NEON_STORAGE_ENDPOINT=https://your-branch.storage.c-6.us-east-2.aws.neon.tech
NEON_STORAGE_REGION=us-east-2
NEON_STORAGE_BUCKET=documents
NEON_STORAGE_ACCESS_KEY_ID=nak_live_your_access_key_id
NEON_STORAGE_SECRET_ACCESS_KEY=nsk_live_your_secret_access_key

# Platform Administrator Credentials (Strict Server-Side Auth)
ADMIN_EMAIL=admin@promovegh.com,admin@promove.com
ADMIN_PASSWORD=YourStrongAdminPassword2026!
ADMIN_SESSION_SECRET=your_32_character_cryptographic_secret
